# Copy to .env for local use. Leave credential fields empty unless you intend
# to make paid calls. Never commit real API keys, tokens, or non-local passwords.

# --- Database (local Docker defaults from docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag_workbench
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Offline embedding default. Hashing does not call a paid API. ---
# Production serving expects EMBEDDING_PROVIDER=openai|openai-compatible and
# EMBEDDING_MODEL=text-embedding-3-small (no silent hashing fallback).
# Retrieval treats openai and openai-compatible as the same semantic space.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=local-hashing-64
EMBEDDING_VERSION=1
EMBEDDING_DIMENSION=64
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
ALLOW_EXTERNAL_CALLS=false
# Must be a positive, reviewed limit before a paid embedding experiment.
MAX_EXTERNAL_EMBEDDING_CALLS=0

# --- Canonical RAG depths (documented; enforced in ProductionRagConfig) ---
# dense_top_k=20 bm25_top_k=20 rrf_k=60 fused_candidate_cap=30 cross_encoder_top_k=15
# Frozen semantic index_identity=e598d9fb… (text-embedding-3-small)
# Luna/Sol are request-scoped verifiers; final_generation_llm=disabled
# POST /rag/query and POST /eval/run both use CanonicalRagRuntime

# --- Evidence sufficiency Judge. Hosted Sol is off by default. ---
ANSWERABILITY_GATE_PROVIDER=
ANSWERABILITY_GATE_MODEL=
ANSWERABILITY_GATE_VERSION=1
ANSWERABILITY_GATE_PROMPT_VERSION=evidence-sufficiency-v1
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5.6-sol
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.openai.com/v1
ALLOW_EXTERNAL_JUDGE_CALLS=false
MAX_EXTERNAL_JUDGE_CALLS=92

# --- Optional local Ollama Judge (not the frozen V2 production Judge). ---
LOCAL_JUDGE_PROVIDER=qwen
LOCAL_JUDGE_MODEL=qwen3:8b
LOCAL_JUDGE_BASE_URL=http://localhost:11434
LOCAL_JUDGE_API_KEY=ollama
MAX_LOCAL_JUDGE_CALLS=92

# --- Corpus / evaluation identity ---
CORPUS_VERSION=acmeai-v0.1
EVALUATION_DATASET_VERSION=acmeai-initial-v1

# --- Generation. Frozen V2 uses extractive, not a hosted LLM. ---
LLM_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
RAG_ADMIN_DEBUG=true
